[Unit]
Description=Mini-Musikplayer UI (front display, buttons, power button)
After=gpio9-pullup.service user@1000.service
Wants=gpio9-pullup.service

[Service]
User=pkenner
WorkingDirectory=/home/pkenner/mp3player
# player.py's mpv subprocess forces --ao=pipewire, which needs to find the
# user PipeWire session's socket at $XDG_RUNTIME_DIR/pipewire-0 - a plain
# system unit (unlike a login session) never gets this set by pam_systemd,
# so mpv silently can't open any audio output at all. Confirmed live: without
# this, every track "plays" (mpv accepts loadfile fine) but immediately
# reports idle-active again since it has no working AO, so PlaybackSync.sync()
# treats it as instantly finished and skips to the next track, cascading
# through the whole playlist in under a second.
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
